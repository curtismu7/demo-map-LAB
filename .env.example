# This app's own settings, read from .env beside docker-compose.yml (gitignored). Copy to .env and edit. Never commit .env.
# Mock needs none of these and makes no network call. Real (host-run only: ./scripts/run.sh) needs AI_DEMO2_URL.
# PORT must be 7808 (this app's one allocated port).
PORT=7808
# The AI-DEMO2 site the page links are built on: a plain http(s) origin, no path, no credentials. Required for Real.
# AI_DEMO2_URL=https://ai-demo2.example
# The local demo shelf Real reads (GET <SHELF_URL>/api/shelf, read-only): an http loopback origin. Default shown.
# SHELF_URL=http://127.0.0.1:4400
# DEMO_MAP_BIND=127.0.0.1   # loopback only unless you set this on purpose (Real is then off)
